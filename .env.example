# PR Security Guard — Environment Variables
# Copy this file to .env (in the docker/ folder) and fill in your values

# ── Mistral AI (Codestral) ──────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key-here

# ── LangSmith (Tracing & Eval) ───────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=pr-security-guard

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me-in-production

# ── Agent Config ──────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.85
